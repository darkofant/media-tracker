generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MediaEntry {
  id                 String    @id @default(cuid())
  title              String
  type               String
  status             String
  rating             Int?
  description        String?
  notes              String?
  coverUrl           String?
  watchedAt          DateTime?
  platform           String?
  playtimeMinutes    Int?
  season             Int?
  episode            Int?
  tmdbId             Int?
  watchedEpisodeKeys String    @default("[]")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ApiCredential {
  provider       String   @id
  encryptedValue String
  updatedAt      DateTime @updatedAt
}
